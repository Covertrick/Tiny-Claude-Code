API_KEY=your_deepseek_api_key
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

QQ_ACCOUNT=
QQ_PASSWORD=
BOT_QQ=
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# NapCat WebUI 登录 Token（不是 QQ 密码；获取方式见 docs/qq-setup.md）
NAPCAT_WEBUI_HOST=127.0.0.1
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=

# 主人 QQ：每日早报 / 关键词提醒 / 健康告警
QQ_OWNER_QQ=
# 群聊关键词（逗号分隔），命中后私聊主人，0 Token
QQ_ALERT_KEYWORDS=紧急,加急,XX项目
QQ_MORNING_BRIEF_HOUR=8
QQ_MORNING_BRIEF_MINUTE=0

# 并发与冷却
QQ_AGENT_CONCURRENCY=3
QQ_USER_COOLDOWN_SECONDS=3
# 发送限流：令牌桶 + 抖动 + 风控熔断
QQ_SEND_BUCKET_CAPACITY=5
QQ_SEND_BUCKET_REFILL=0.8
QQ_SEND_JITTER_MIN=1.2
QQ_SEND_JITTER_MAX=2.8
QQ_SEND_BREAKER_FAILS=3
QQ_SEND_BREAKER_COOL=120
# 群缓存滚动摘要
QQ_GROUP_CACHE_SUMMARY_TRIGGER=30
QQ_GROUP_CACHE_SUMMARY_KEEP=10

# 资讯速递（Phase 2）
QQ_RSS_URLS=https://www.solidot.org/index.rss
QQ_GITHUB_REPOS=
QQ_DIGEST_HOUR=8
QQ_DIGEST_MINUTE=30
QQ_DIGEST_USE_LLM=0

# 嵌入 / 向量索引 / 增量知识卡片（Phase 5）
QQ_EMBEDDING_BACKEND=auto
# 强制语义：1=优先 fastembed（默认）| strict=没有 fastembed 就启动失败 | 0=允许纯哈希
QQ_FORCE_SEMANTIC=1
# fastembed 首次加载总超时（秒）；HF 不通时超时后回退哈希
QQ_EMBEDDING_LOAD_TIMEOUT=25
# 向量库：auto≈sqlite-vec（无扩展则 BLOB 暴力回退）| memory=仅内存
QQ_VECTOR_BACKEND=auto
# 国内可设镜像后再启，以便真正拉起语义模型：
# HF_ENDPOINT=https://hf-mirror.com
QQ_SYNTHESIS_THRESHOLD=0.72
# 记忆预召回最低分（门控通过后硬截断弱相关）
# 哈希向量默认 0.32；上 fastembed 后可调到 0.72~0.82
QQ_RECALL_MIN_SCORE=0.32
# 意图门控：llm=模型分类（默认）| regex=关键词 | off=每轮都注入
QQ_INTENT_GATE=llm

# —— Phase 4：Magic Link 控制台（需 fastapi uvicorn itsdangerous）——
QQ_ADMIN_PORT=8787
# QQ_ADMIN_SECRET=          # 可选；默认派生自 API_KEY
QQ_ADMIN_MAGIC_TTL=900
QQ_ADMIN_PUBLIC_HOST=auto   # 无隧道时的局域网兜底
QQ_ADMIN_BIND=0.0.0.0
QQ_ADMIN_TUNNEL=cloudflare  # cloudflare=公网免账号 | off=关
# QQ_ADMIN_PUBLIC_URL=https://你的固定域名  # 有域名可写死，优先生效
QQ_ADMIN_AUTO_OPEN=1
# 私聊「打开控制台」→ 优先发 trycloudflare 公网链接（手机流量可开）

# —— Phase 4：Obsidian Vault（需 watchdog；Git 提交需 GitPython 或本机 git）——
# QQ_VAULT_PATH=D:/Obsidian/MyVault
QQ_VAULT_WATCH=1
QQ_VAULT_GIT_COMMIT=1
QQ_VAULT_GIT_PUSH=0
QQ_VAULT_NOTES_SUBDIR=QQ Agent
QQ_VAULT_REINDEX_ON_START=0

# 启动 Agent 时顺便自动打开并登录 WebUI（1=开）
QQ_OPEN_WEBUI=0

# 打开外网链接（Reddit 等）用的 HTTP 代理；Clash 常见 7890
# QQ_FETCH_PROXY=http://127.0.0.1:7890

# 掉线告警（任选其一）
SERVERCHAN_SENDKEY=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_TO=
